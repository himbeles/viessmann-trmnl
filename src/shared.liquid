{% template use_energy %}
{% assign electricity = energy.by_use[scope] %}{% assign thermal = heat.by_use[scope] %}
<div class="vp-use-energy">
  <div><span class="vp-label">{{ labels[39] }}:</span> <b>{% if electricity.today_kwh != nil %}{{ electricity.today_kwh | round: 2 | replace: '.', decimal }}{% else %}—{% endif %} kWh</b></div>
  <div><span class="vp-label">{{ labels[53] }}:</span> <b>{% if thermal.today_kwh != nil %}{{ thermal.today_kwh | round: 2 | replace: '.', decimal }}{% else %}—{% endif %} kWh</b></div>
</div>
{% endtemplate %}
{% template dashboard %}
{% comment %}Read-only Viessmann data. No write commands or tokens in rendered markup.{% endcomment %}
{% assign cfg = trmnl.plugin_settings.custom_fields_values %}
{% assign language = cfg.language | default: 'en' %}
{% if language == 'de' %}
{% assign labels = 'Viessmann Wärmepumpe|Zuhause · Heizkreis|DEMO · Beispieldaten|Noch nicht verbunden|Daten veraltet|Zeitstand unbekannt||Heizung|Vorlauftemperatur|Warmwasser|Speichertemperatur|Außen|Außensensor|Heizkurve|Heizkurve mit Vorlaufgrenzen|Außentemperatur °C||Heizkurve benötigt Neigung,<br>Niveau und Raum-Solltemperatur.|Neigung|Niveau|Betriebsart|Heizen + Warmwasser|Nur Warmwasser|Heizen|Nicht verfügbar|Sensor-Zeitstand:|Messzeitpunkt fehlt|Werte unvollständig|Nur Anzeige|Soll|Raum-Solltemperatur|Referenzpunkte|Ungültige Referenzpunkte|Max.|||Grenze nicht verfügbar||Strom aktuell|Strom heute|Gesamtes Gerät|Verdichter|Heizstab|Heizung + Warmwasser|Heizung + Warmwasser + Kühlung|Nur Heizung|Nur Warmwasser|Nur Kühlung|Stand:|Kein Tageswert für heute|Zeitstand unbekannt|Tageszähler der Anlage|Wärme aktuell|Wärme heute|Kühlung|Heizung an|Heizung aus|Heizung unbekannt|Vorlauf aktuell|Wärmepumpenvorlauf|Heizkreisvorlauf|Druck|Gesamt|Aus|Status unbekannt|Rücklauf|Rücklauf WP|Aktualisiert:' | split: '|' %}
{% assign decimal = ',' %}
{% else %}
{% assign language = 'en' %}
{% assign labels = 'Viessmann heat pump|Home · Heating circuit|DEMO · Sample data|Not connected|Stale data|Timestamp unknown||Heating|Supply temperature|Hot water|Cylinder temperature|Outdoor|Outdoor sensor|Heating curve|Heating curve with supply limits|Outdoor temperature °C||The heating curve needs slope,<br>offset and a room setpoint.|Slope|Offset|Operating mode|Heating + hot water|Hot water only|Heating|Unavailable|Sensor timestamp:|Reading timestamp missing|Incomplete data|Read only|Target|Room setpoint|Reference points|Invalid reference points|Max.|||Limit unavailable||Electricity now|Electricity today|Whole device|Compressor|Auxiliary heater|Heating + hot water|Heating + hot water + cooling|Heating only|Hot water only|Cooling only|As of:|No counter for today|Timestamp unknown|Device day counter|Heat output now|Heat today|Cooling|Heating on|Heating off|Heating unknown|Supply now|Heat pump supply|Circuit supply|Pressure|Total|Off|Status unknown|Return|Heat pump return|Updated:' | split: '|' %}
{% assign decimal = '.' %}
{% endif %}
{% assign features = data %}
{% if IDX_0.data %}{% assign features = IDX_0.data %}{% endif %}
{% assign circuit = cfg.circuit | default: '0' | append: '' %}
{% assign prefix = 'heating.circuits.' | append: circuit %}
{% assign supply_key = supply_reading.feature | default: cfg.supply_feature | default: 'heating.secondaryCircuit.sensors.temperature.supply' %}
{% assign water_key = cfg.water_feature | default: 'heating.dhw.sensors.temperature.dhwCylinder' %}
{% assign outside_key = cfg.outside_feature | default: 'heating.sensors.temperature.outside' %}
{% assign curve_key = prefix | append: '.heating.curve' %}
{% assign mode_key = prefix | append: '.operating.modes.active' %}
{% assign supply = nil %}{% assign water = nil %}{% assign outside = nil %}
{% assign slope = nil %}{% assign shift = nil %}{% assign mode = nil %}
{% assign found = 0 %}
{% for f in features %}
  {% assign used = false %}
  {% if f.isEnabled != false %}
    {% case f.feature %}
      {% when supply_key %}
        {% if f.properties.value.value != nil and f.properties.status.value != 'error' %}
          {% assign supply = f.properties.value.value %}{% assign used = true %}
        {% endif %}
      {% when water_key %}
        {% if f.properties.value.value != nil and f.properties.status.value != 'error' %}
          {% assign water = f.properties.value.value %}{% assign used = true %}
        {% endif %}
      {% when outside_key %}
        {% if f.properties.value.value != nil and f.properties.status.value != 'error' %}
          {% assign outside = f.properties.value.value %}{% assign used = true %}
        {% endif %}
      {% when curve_key %}
        {% assign slope = f.properties.slope.value %}{% assign shift = f.properties.shift.value %}
        {% if slope != nil or shift != nil %}{% assign used = true %}{% endif %}
      {% when mode_key %}
        {% assign mode = f.properties.value.value %}
        {% if mode != nil %}{% assign used = true %}{% endif %}
    {% endcase %}
  {% endif %}
  {% if used %}{% assign found = found | plus: 1 %}{% endif %}
{% endfor %}
<style>
  .vp{height:100%;width:100%;box-sizing:border-box;display:flex;flex-direction:column;padding:3%;gap:12px;font-family:Arial,sans-serif;color:#000;background:#fff}
  .vp *{box-sizing:border-box}.vp-head{display:flex;align-items:center;justify-content:space-between;padding-bottom:10px;gap:10px}
  .vp-brand{font-size:24px;font-weight:800;letter-spacing:-.04em}.vp-kicker{font-size:11px;letter-spacing:.1em;text-transform:uppercase}
  .vp-badge{border:2px solid #000;border-radius:4px;padding:5px 8px;font-size:11px;font-weight:bold;text-align:center}.vp-activity{margin-left:auto;white-space:nowrap}.vp-activity-on{color:#fff;background:#000}
  .vp-blocks{display:grid;grid-template-columns:minmax(0,2.1fr) minmax(0,1fr);grid-template-rows:auto minmax(0,1fr);gap:12px;flex:1;min-height:0}
  .vp-block{border:1px solid #000;border-radius:5px;padding:13px;min-width:0;min-height:0;display:flex;flex-direction:column;gap:8px}.vp-block-title{font-size:17px;font-weight:800;border-bottom:1px solid #000;padding-bottom:6px;margin:0}
  .vp-heating-block{grid-column:1;grid-row:1 / 3}.vp-water-block{grid-column:2;grid-row:1}.vp-energy-block{grid-column:2;grid-row:2}
  .vp-label{font-size:12px;font-weight:bold}.vp-note{font-size:11px;line-height:1.3}.vp-unit{font-size:.42em;letter-spacing:0;margin-left:3px}.vp-value{font-size:52px;font-weight:700;letter-spacing:-.05em;line-height:1.1;white-space:nowrap}.vp-target{font-size:14px;font-weight:bold}
  .vp-metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.vp-metric+.vp-metric{border-left:1px solid #000;padding-left:12px}.vp-metrics .vp-value{font-size:28px}.vp-pressure .vp-note{font-size:9px}
  .vp-bottom{display:flex;flex-direction:column;gap:6px;flex:1;min-height:0}.vp-chart{display:flex;flex-direction:column;gap:4px;flex:1;min-height:0}.vp-chart svg{width:100%;flex:1;min-height:0}
  .vp-params{display:flex;justify-content:space-between;gap:8px;border-top:1px solid #000;padding-top:6px}.vp-param{font-size:20px;font-weight:bold}.vp-params .vp-label{font-size:11px}
  .vp-energy{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 8px;flex:1;align-content:space-around}.vp-energy .vp-label{font-size:11px}.vp-energy-value{font-size:25px;font-weight:750;line-height:1.2;white-space:nowrap}.vp-energy-note{font-size:9px;line-height:1.3;overflow-wrap:anywhere}
  .vp-footer{display:flex;justify-content:space-between;gap:10px;font-size:10px;padding-top:6px}.vp-empty{flex:1;display:flex;align-items:center;justify-content:center;border:1px dashed #000;text-align:center;font-size:12px;padding:8px}
  .vp-compact{padding:2%;gap:7px}.vp-compact .vp-head{padding-bottom:6px}.vp-compact .vp-brand{font-size:17px}.vp-compact .vp-kicker{font-size:9px}.vp-compact .vp-blocks{grid-template-columns:minmax(0,1.9fr) minmax(0,.8fr) minmax(0,1.3fr);grid-template-rows:minmax(0,1fr);gap:7px}.vp-compact .vp-heating-block{grid-column:1;grid-row:1}.vp-compact .vp-water-block{grid-column:2;grid-row:1}.vp-compact .vp-energy-block{grid-column:3;grid-row:1}
  .vp-compact .vp-block{padding:7px;gap:5px}.vp-compact .vp-block-title{font-size:13px;padding-bottom:4px}.vp-compact .vp-value{font-size:30px}.vp-compact .vp-metrics .vp-value{font-size:21px}.vp-compact .vp-label{font-size:10px}.vp-compact .vp-target{font-size:11px}.vp-compact .vp-note{font-size:9px}.vp-compact .vp-energy-value{font-size:19px}.vp-compact .vp-energy-note{font-size:8px}.vp-compact .vp-chart>.vp-note,.vp-compact .vp-pressure .vp-note{display:none}.vp-compact .vp-footer{font-size:8px;padding-top:4px}.vp-compact .vp-chart svg{min-height:45px}
  .vp-small .vp-kicker{display:none}.vp-small .vp-brand{font-size:15px}.vp-small .vp-badge{font-size:9px;padding:4px}.vp-small .vp-blocks{grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);grid-template-rows:auto minmax(0,1fr)}.vp-small .vp-water-block{grid-column:1;grid-row:1}.vp-small .vp-energy-block{grid-column:2;grid-row:1}.vp-small .vp-heating-block{grid-column:1 / 3;grid-row:2}.vp-small .vp-energy{gap:5px}.vp-small .vp-energy-value{font-size:17px}.vp-small .vp-block-title{font-size:12px}.vp-small .vp-label{font-size:9px}.vp-small .vp-energy-note{font-size:7px}.vp-small .vp-metrics{gap:8px}.vp-small .vp-metric+.vp-metric{padding-left:8px}.vp-small .vp-heating-block{position:relative}.vp-small .vp-heating-block>.vp-block-title{padding-bottom:5px}.vp-small .vp-metrics{position:absolute;top:7px;right:7px;width:65%}.vp-small .vp-metrics .vp-metric{display:flex;align-items:baseline;gap:4px}.vp-small .vp-metrics .vp-value{font-size:16px}.vp-small .vp-metrics .vp-label{font-size:9px}.vp-small .vp-chart>.vp-label{display:none}
  .vp-block-active{border-width:2px;padding:12px}.vp-use-energy{color:#000;font-size:12px;line-height:1.5;border-top:1px solid #aaa;padding-top:5px}.vp-use-energy b{color:#000;font-weight:600}.vp-water-block .vp-use-energy{margin-top:8px}.vp-compact .vp-block{padding:8px}.vp-compact .vp-block-active{padding:7px}.vp-compact .vp-use-energy{font-size:10px;line-height:1.3;padding-top:3px}.vp-compact .vp-params{display:flex;padding-top:3px}.vp-compact .vp-param{font-size:13px}.vp-compact .vp-params .vp-label{font-size:9px}.vp-small .vp-use-energy{font-size:9px}.vp-small .vp-heating-block>.vp-use-energy{display:flex;justify-content:space-between;gap:5px}.vp-small .vp-params{gap:5px}.vp-small .vp-params>div{display:flex;align-items:baseline;gap:5px}.vp-small .vp-param{font-size:11px}
  .vp-small .vp-metrics{position:static;width:auto;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px}.vp-small .vp-metrics .vp-metric{display:block}.vp-small .vp-metrics .vp-value{font-size:15px}.vp-small .vp-metrics .vp-label{font-size:8px}.vp-compact .vp-room-target .vp-label{font-size:9px}
  .vp-block-title,.vp-metrics,.vp-params,.vp-use-energy{flex-shrink:0}.vp-small .vp-blocks{grid-template-rows:minmax(0,1fr) minmax(0,1.5fr)}.vp-small .vp-water .vp-note{display:none}.vp-small .vp-water-block .vp-use-energy{margin-top:3px}.vp-small .vp-water .vp-value{font-size:24px}.vp-small .vp-block{gap:4px}.vp-small .vp-energy-value{font-size:15px}.vp-small .vp-energy-note{font-size:7px}
  .vp-small .vp-energy{gap:3px;align-content:start}.vp-small .vp-energy .vp-label{font-size:8px;line-height:1.1}.vp-small .vp-energy-value{font-size:14px;line-height:1.1}.vp-small .vp-energy-note{line-height:1.1}
  .vp-kicker,.vp-note,.vp-energy-note,.vp-footer{color:#666}
  .vp-params>div{display:flex;align-items:baseline;gap:5px}.vp-params .vp-label{font-size:9px}.vp-params .vp-param{font-size:12px}.vp-params>div:not(.vp-pressure){color:#666}.vp-params .vp-pressure .vp-label{font-size:12px}.vp-params .vp-pressure .vp-value{font-size:16px;letter-spacing:0}.vp-compact .vp-params .vp-label{font-size:8px}.vp-compact .vp-params .vp-param{font-size:10px}.vp-compact .vp-params .vp-pressure .vp-label{font-size:10px}.vp-compact .vp-params .vp-pressure .vp-value{font-size:13px}.vp-small .vp-params .vp-label{font-size:7px}.vp-small .vp-params .vp-param{font-size:9px}.vp-small .vp-params .vp-pressure .vp-label{font-size:9px}.vp-small .vp-params .vp-pressure .vp-value{font-size:11px}.vp-params .vp-pressure .vp-note:empty{display:none}
</style>
<div class="vp{% if variant != 'full' %} vp-compact{% endif %}{% if variant == 'half_vertical' or variant == 'quadrant' %} vp-small{% endif %}" lang="{{ language }}">
  <div class="vp-head"><div><div class="vp-kicker">{{ labels[1] }} {{ circuit | escape }}</div><div class="vp-brand">{{ labels[0] }}</div></div>
    {% if demo or found == 0 or freshness.missing_time %}<div class="vp-badge">{% if demo %}{{ labels[2] }}{% elsif found == 0 %}{{ labels[3] }}{% elsif freshness.missing_time %}{{ labels[5] }}{% endif %}</div>{% endif %}
    <div class="vp-badge vp-activity{% if activity.state == 'dhw' or activity.state == 'heating' %} vp-activity-on{% endif %}">{% case activity.state %}{% when 'dhw' %}{{ labels[9] }}{% when 'heating' %}{{ labels[7] }}{% when 'off' %}{{ labels[63] }}{% else %}{{ labels[64] }}{% endcase %}</div>
  </div>
  <div class="vp-blocks">
    <section class="vp-block vp-heating-block{% if activity.state == 'heating' %} vp-block-active{% endif %}" aria-label="{{ labels[7] }}">
      <h2 class="vp-block-title">{{ labels[7] }}</h2>
      <div class="vp-metrics">
        <div class="vp-metric"><div class="vp-label">{{ labels[11] }}</div><div class="vp-value">{% if outside != nil %}{{ outside | round: 1 | replace: '.', decimal }}{% else %}—{% endif %}<span class="vp-unit">°C</span></div></div>
        <div class="vp-metric vp-room-target"><div class="vp-label">{{ labels[30] }}</div><div class="vp-value">{% if setpoints.room != nil %}{{ setpoints.room | round: 1 | replace: '.', decimal }}{% else %}—{% endif %}<span class="vp-unit">°C</span></div></div>
      </div>
  <div class="vp-bottom">
    <div class="vp-chart"><div class="vp-label">{{ labels[13] }}</div>
    {% if curve.points.size > 1 %}
      <svg viewBox="0 0 620 210" role="img" aria-label="{% if curve.reference %}{{ labels[31] }}{% else %}{{ labels[14] }}{% endif %}" preserveAspectRatio="xMidYMid meet">
        <path d="M48 20V156H434" fill="none" stroke="#000"/>
        {% for tick in curve.ticks %}<path d="M48 {{ tick.y }}H434" fill="none" stroke="#000" stroke-dasharray="2 5"/><text x="40" y="{{ tick.y | plus: 4 }}" text-anchor="end" font-size="12">{{ tick.value | replace: '.', decimal }}</text>{% endfor %}
        {% for tick in curve.x_ticks %}<path class="vp-x-tick" d="M{{ tick.x }} 156v4" stroke="#000"/><text x="{{ tick.x }}" y="178" text-anchor="middle" font-size="12">{{ tick.value | replace: '.', decimal }}</text>{% endfor %}
        <text x="6" y="14" font-size="12">°C</text><text x="235" y="204" text-anchor="middle" font-size="12">{{ labels[15] }}</text>
        <polyline fill="none" stroke="#000" stroke-width="3" points="{{ curve.polyline | escape }}"/>
        {% for point in curve.step_points %}<circle class="vp-curve-step" cx="{{ point.x }}" cy="{{ point.y }}" r="2.5" fill="#000"/>{% endfor %}
        {% if curve.target %}<path class="vp-target-marker" d="M{{ curve.target.x }} {{ curve.target.y | minus: 8 }}l8 8 -8 8 -8 -8Z" fill="#fff" stroke="#000" stroke-width="2"/>{% endif %}
        <g class="vp-curve-readings" font-family="Arial, sans-serif">
          <text x="477" y="33" font-size="13">{% case supply_scope %}{% when 'heat_pump' %}{{ labels[59] }}{% when 'circuit' %}{{ labels[60] }}{% else %}{{ labels[58] }}{% endcase %}</text>
          <text x="477" y="58" font-size="24" font-weight="bold">{% if supply != nil %}{{ supply | round: 1 | replace: '.', decimal }}{% else %}—{% endif %} °C</text>
          <text x="477" y="92" font-size="13">{% if return_reading.scope == 'heat_pump' %}{{ labels[66] }}{% else %}{{ labels[65] }}{% endif %}</text>
          <text x="477" y="117" font-size="24" font-weight="bold">{% if return_reading.value != nil %}{{ return_reading.value | round: 1 | replace: '.', decimal }}{% else %}—{% endif %} °C</text>
          <path d="M463 142l5 5 -5 5 -5 -5Z" fill="#fff" stroke="#000" stroke-width="2"/>
          <text x="477" y="151" font-size="13">{{ labels[29] }}</text>
          <text x="477" y="176" font-size="24" font-weight="bold">{% if setpoints.supply != nil %}{{ setpoints.supply | round: 1 | replace: '.', decimal }}{% else %}—{% endif %} °C</text>
        </g>
      </svg>
      {% if curve.invalid_reference %}<div class="vp-note">{{ labels[32] }}</div>{% elsif curve.reference %}<div class="vp-note">{{ labels[31] }}</div>{% endif %}
    {% else %}<div class="vp-empty">{{ labels[17] }}</div><div class="vp-note">{% case supply_scope %}{% when 'heat_pump' %}{{ labels[59] }}{% when 'circuit' %}{{ labels[60] }}{% else %}{{ labels[58] }}{% endcase %}: {% if supply != nil %}{{ supply | round: 1 | replace: '.', decimal }} °C{% else %}—{% endif %} · {{ labels[29] }}: {% if setpoints.supply != nil %}{{ setpoints.supply | round: 1 | replace: '.', decimal }} °C{% else %}—{% endif %}</div>{% endif %}
    </div>
  </div>
      {% render "use_energy", scope: "heating", energy: energy, heat: heat, labels: labels, decimal: decimal %}
    <div class="vp-params"><div><div class="vp-label">{{ labels[18] }}</div><div class="vp-param">{% if slope != nil %}{{ slope | replace: '.', decimal }}{% else %}—{% endif %}</div></div><div><div class="vp-label">{{ labels[19] }}</div><div class="vp-param">{% if shift != nil %}{{ shift | replace: '.', decimal }} K{% else %}—{% endif %}</div></div><div class="vp-pressure"><div class="vp-label">{{ labels[61] }}</div><div class="vp-value">{% if pressure.bar != nil %}{{ pressure.bar | round: 2 | replace: '.', decimal }}{% else %}—{% endif %}<span class="vp-unit">bar</span></div><div class="vp-note">{% if pressure.bar != nil %}{% else %}{{ labels[24] }}{% endif %}</div></div></div>
    </section>
    <section class="vp-block vp-water-block{% if activity.state == 'dhw' %} vp-block-active{% endif %}" aria-label="{{ labels[9] }}"><h2 class="vp-block-title">{{ labels[9] }}</h2>
    <div class="vp-water"><div class="vp-value">{% if water != nil %}{{ water | round: 1 | replace: '.', decimal }}{% else %}—{% endif %}<span class="vp-unit">°C</span></div><div class="vp-note">{{ labels[10] }}</div><div class="vp-target">{{ labels[29] }}: {% if setpoints.water != nil %}{{ setpoints.water | round: 1 | replace: '.', decimal }} °C{% else %}—{% endif %}</div></div>
      {% render "use_energy", scope: "dhw", energy: energy, heat: heat, labels: labels, decimal: decimal %}
    </section>
    <section class="vp-block vp-energy-block" aria-label="{{ labels[62] }}"><h2 class="vp-block-title">{{ labels[62] }}</h2>
  <div class="vp-energy">
    <div><div class="vp-label">{{ labels[38] }}</div><div class="vp-energy-value">{% if energy.power_kw != nil %}{{ energy.power_kw | round: 2 | replace: '.', decimal }}{% else %}—{% endif %} <span class="vp-unit">kW</span></div><div class="vp-energy-note">{% case energy.power_scope %}{% when 'device' %}{{ labels[40] }}{% when 'compressor' %}{{ labels[41] }}{% when 'heater' %}{{ labels[42] }}{% else %}{{ labels[24] }}{% endcase %}</div></div>
    <div><div class="vp-label">{{ labels[39] }}</div><div class="vp-energy-value">{% if energy.today_kwh != nil %}{{ energy.today_kwh | round: 2 | replace: '.', decimal }}{% else %}—{% endif %} <span class="vp-unit">kWh</span></div><div class="vp-energy-note">{% case energy.today_scope %}{% when 'device' %}{{ labels[40] }}{% when 'compressor' %}{{ labels[41] }}{% when 'heater' %}{{ labels[42] }}{% when 'heating_dhw' %}{{ labels[43] }}{% when 'heating_dhw_cooling' %}{{ labels[44] }}{% when 'heating' %}{{ labels[45] }}{% when 'dhw' %}{{ labels[46] }}{% when 'cooling' %}{{ labels[47] }}{% else %}{% if energy.today_outdated %}{{ labels[49] }}{% else %}{{ labels[24] }}{% endif %}{% endcase %}</div></div>
    <div><div class="vp-label">{{ labels[52] }}</div><div class="vp-energy-value">{% if heat.power_kw != nil %}{{ heat.power_kw | round: 2 | replace: '.', decimal }}{% else %}—{% endif %} <span class="vp-unit">kW</span></div><div class="vp-energy-note">{% case heat.power_scope %}{% when 'device' %}{{ labels[40] }}{% when 'compressor' %}{{ labels[41] }}{% when 'heater' %}{{ labels[42] }}{% else %}{{ labels[24] }}{% endcase %}</div></div>
    <div><div class="vp-label">{{ labels[53] }}</div><div class="vp-energy-value">{% if heat.today_kwh != nil %}{{ heat.today_kwh | round: 2 | replace: '.', decimal }}{% else %}—{% endif %} <span class="vp-unit">kWh</span></div><div class="vp-energy-note">{% if heat.today_kwh != nil %}{{ labels[40] }}{% elsif heat.today_outdated %}{{ labels[49] }}{% else %}{{ labels[24] }}{% endif %}</div></div>
  </div>
    </section>
  </div>
  <div class="vp-footer"><span>{% if freshness.latest_reading %}{{ labels[67] }} {{ freshness.latest_reading | escape }}{% else %}{{ labels[26] }}{% endif %}</span></div>
</div>

{% endtemplate %}
