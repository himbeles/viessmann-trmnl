{% template glyph %}
<svg class="vp-glyph" data-glyph="{{ kind }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{% case kind %}{% when 'heating' %}<path d="M4 9h16v12H4zM8 9v12m4-12v12m4-12v12M7 2c-3 2 3 3 0 5m5-5c-3 2 3 3 0 5m5-5c-3 2 3 3 0 5"/>{% when 'water' %}<path d="M12 2C9 7 5 11 5 15a7 7 0 0 0 14 0c0-4-4-8-7-13Z"/><path d="M8 15a4 4 0 0 0 4 4"/>{% when 'pressure' %}<circle cx="12" cy="12" r="9"/><path d="m12 12 4-4M5 12h2m10 0h2M12 5v2M7 7l1.5 1.5M6 18h12"/><circle cx="12" cy="12" r="1"/>{% when 'compressor' %}<circle cx="12" cy="12" r="9"/><path d="m8 7 10 5-10 5V7Zm-4 9 14-9"/>{% when 'auxiliary' %}<path d="M8 2v3h9L7 10h10L7 15h10L8 20v2"/>{% when 'fan' %}<circle cx="12" cy="12" r="1"/><path d="M11 10C5 9 5 2 10 3c3 0 2 5 1 7Zm3 1c1-6 8-6 7-1 0 3-5 2-7 1Zm-1 3c6 1 6 8 1 7-3 0-2-5-1-7Zm-3-1c-1 6-8 6-7 1 0-3 5-2 7-1Z"/>{% endcase %}
</svg>
{% endtemplate %}
{% template use_energy %}
{% assign electricity = energy.by_use[scope] %}{% assign thermal = heat.by_use[scope] %}
<div class="vp-use-energy">
  <div><span class="vp-label">{{ labels[39] }}:</span> <b>{% if electricity.today_kwh != nil %}{{ electricity.today_kwh | round: 2 | replace: '.', decimal }}{% else %}—{% endif %} kWh</b></div>
  <div><span class="vp-label">{{ labels[53] }}:</span> <b>{% if thermal.today_kwh != nil %}{{ thermal.today_kwh | round: 2 | replace: '.', decimal }}{% else %}—{% endif %} kWh</b></div>
</div>
{% endtemplate %}
{% template day_comparison %}
<div class="vp-day-comparison">
  <div class="vp-yesterday"><div class="vp-day-label">{{ labels[73] }}</div><div class="vp-previous-value vp-energy-value">{% if metrics.yesterday_kwh != nil %}{{ metrics.yesterday_kwh | round: 2 | replace: '.', decimal }} <span class="vp-unit">kWh</span>{% else %}—{% endif %}</div></div>
  <div class="vp-comparison-arrow">{% if metrics.trend %}<span class="vp-trend" role="img" aria-label="{% case metrics.trend %}{% when 'up' %}{{ labels[74] }}{% when 'down' %}{{ labels[75] }}{% else %}{{ labels[76] }}{% endcase %}">{% case metrics.trend %}{% when 'up' %}↗{% when 'down' %}↘{% else %}→{% endcase %}</span>{% endif %}</div>
  <div class="vp-today"><div class="vp-day-label">{{ labels[79] }}</div><div class="vp-energy-value">{% if metrics.today_kwh != nil %}{{ metrics.today_kwh | round: 2 | replace: '.', decimal }}{% else %}—{% endif %} <span class="vp-unit">kWh</span></div></div>
</div>
{% endtemplate %}
{% template dashboard %}
{% comment %}Read-only Viessmann data. No write commands or tokens in rendered markup.{% endcomment %}
{% assign cfg = trmnl.plugin_settings.custom_fields_values %}
{% assign language = cfg.language | default: 'en' %}
{% if language == 'de' %}
{% assign labels = 'Viessmann Wärmepumpe|Zuhause · Heizkreis|DEMO · Beispieldaten|Noch nicht verbunden|Daten veraltet|Zeitstand unbekannt||Heizung|Vorlauftemperatur|Warmwasser|Speichertemperatur|Außen|Außensensor|Heizkurve|Heizkurve mit Vorlaufgrenzen|Außentemperatur °C||Heizkurve benötigt Neigung,<br>Niveau und Raum-Solltemperatur.|Neigung|Niveau|Betriebsart|Heizen + Warmwasser|Nur Warmwasser|Heizen|Nicht verfügbar|Sensor-Zeitstand:|Messzeitpunkt fehlt|Werte unvollständig|Nur Anzeige|Soll|Raum-Solltemperatur|Referenzpunkte|Ungültige Referenzpunkte|Max.|||Grenze nicht verfügbar||Strom aktuell|Strom heute|Gesamtes Gerät|Verdichter|Elektrische Zusatzheizung|Heizung + Warmwasser|Heizung + Warmwasser + Kühlung|Nur Heizung|Nur Warmwasser|Nur Kühlung|Stand:|Kein Tageswert für heute|Zeitstand unbekannt|Tageszähler der Anlage|Wärme aktuell|Wärme heute|Kühlung|Heizung an|Heizung aus|Heizung unbekannt|Vorlauf aktuell|Wärmepumpenvorlauf|Heizkreisvorlauf|Druck|Verbrauch heute|Aus|Status unbekannt|Rücklauf|Rücklauf WP|Aktualisiert:|Vorlauf-Solltemperatur|Heizkreis-Vorlauf|Leistung|Ventilator|Ein|Gestern|Heute höher als gestern|Heute niedriger als gestern|Gleich wie gestern|Strom|Wärme|Heute' | split: '|' %}
{% assign decimal = ',' %}
{% else %}
{% assign language = 'en' %}
{% assign labels = 'Viessmann heat pump|Home · Heating circuit|DEMO · Sample data|Not connected|Stale data|Timestamp unknown||Heating|Supply temperature|Hot water|Cylinder temperature|Outdoor|Outdoor sensor|Heating curve|Heating curve with supply limits|Outdoor temperature °C||The heating curve needs slope,<br>offset and a room setpoint.|Slope|Offset|Operating mode|Heating + hot water|Hot water only|Heating|Unavailable|Sensor timestamp:|Reading timestamp missing|Incomplete data|Read only|Target|Room setpoint|Reference points|Invalid reference points|Max.|||Limit unavailable||Electricity now|Electricity today|Whole device|Compressor|Electric auxiliary heating|Heating + hot water|Heating + hot water + cooling|Heating only|Hot water only|Cooling only|As of:|No counter for today|Timestamp unknown|Device day counter|Heat output now|Heat today|Cooling|Heating on|Heating off|Heating unknown|Supply now|Heat pump supply|Circuit supply|Pressure|Usage today|Off|Status unknown|Return|Heat pump return|Updated:|Supply target temperature|Circuit supply|Power|Fan|On|Yesterday|Today higher than yesterday|Today lower than yesterday|Same as yesterday|Electricity|Heat|Today' | split: '|' %}
{% assign decimal = '.' %}
{% endif %}
{% assign features = data %}
{% if IDX_0.data %}{% assign features = IDX_0.data %}{% endif %}
{% assign circuit = cfg.circuit | default: '0' | append: '' %}
{% assign prefix = 'heating.circuits.' | append: circuit %}
{% assign supply_key = supply_reading.feature | default: cfg.supply_feature | default: 'heating.secondaryCircuit.sensors.temperature.supply' %}
{% assign water_key = cfg.water_feature | default: 'heating.dhw.sensors.temperature.dhwCylinder' %}
{% assign outside_key = cfg.outside_feature | default: 'heating.sensors.temperature.outside' %}
{% assign curve_key = prefix | append: '.heating.curve' %}
{% assign mode_key = prefix | append: '.operating.modes.active' %}
{% assign supply = nil %}{% assign water = nil %}{% assign outside = nil %}
{% assign slope = nil %}{% assign shift = nil %}{% assign mode = nil %}
{% assign found = 0 %}
{% for f in features %}
  {% assign used = false %}
  {% if f.isEnabled != false %}
    {% case f.feature %}
      {% when supply_key %}
        {% if f.properties.value.value != nil and f.properties.status.value != 'error' %}
          {% assign supply = f.properties.value.value %}{% assign used = true %}
        {% endif %}
      {% when water_key %}
        {% if f.properties.value.value != nil and f.properties.status.value != 'error' %}
          {% assign water = f.properties.value.value %}{% assign used = true %}
        {% endif %}
      {% when outside_key %}
        {% if f.properties.value.value != nil and f.properties.status.value != 'error' %}
          {% assign outside = f.properties.value.value %}{% assign used = true %}
        {% endif %}
      {% when curve_key %}
        {% assign slope = f.properties.slope.value %}{% assign shift = f.properties.shift.value %}
        {% if slope != nil or shift != nil %}{% assign used = true %}{% endif %}
      {% when mode_key %}
        {% assign mode = f.properties.value.value %}
        {% if mode != nil %}{% assign used = true %}{% endif %}
    {% endcase %}
  {% endif %}
  {% if used %}{% assign found = found | plus: 1 %}{% endif %}
{% endfor %}
