{% comment %}Combined day counters retain the timestamp and age of every component.{% endcomment %}
{% template daily_counter_age %}
{% if metric.today_components %}
  {% for component in metric.today_components %}{% if component.stale %} · {% case component.scope %}{% when 'heating' %}{{ labels[7] }}{% when 'dhw' %}{{ labels[9] }}{% when 'cooling' %}{{ labels[54] }}{% endcase %}: {{ labels[4] }}{% endif %}{% endfor %}
{% elsif metric.today_stale %} · {{ labels[4] }}{% endif %}
{% endtemplate %}
{% template daily_counter_timestamps %}
{% if metric.today_components %}
  {% for component in metric.today_components %}<div>{% case component.scope %}{% when 'heating' %}{{ labels[7] }}{% when 'dhw' %}{{ labels[9] }}{% when 'cooling' %}{{ labels[54] }}{% endcase %}: {{ component.updated | escape }}</div>{% endfor %}
{% elsif metric.today_updated %}{{ labels[48] }} {{ metric.today_updated | escape }}{% else %}{{ labels[51] }}{% endif %}
{% endtemplate %}
{% template dashboard %}
{% comment %}Read-only Viessmann data. No write commands or tokens in rendered markup.{% endcomment %}
{% assign cfg = trmnl.plugin_settings.custom_fields_values %}
{% assign language = cfg.language | default: 'en' %}
{% if language == 'de' %}
{% assign labels = 'Viessmann Wärmepumpe|Zuhause · Heizkreis|DEMO · Beispieldaten|Noch nicht verbunden|Daten veraltet|Zeitstand unbekannt||Heizung|Vorlauftemperatur|Warmwasser|Speichertemperatur|Außen|Außensensor|Heizkurve|Heizkurve mit Vorlaufgrenzen|Außentemperatur °C||Heizkurve benötigt Neigung,<br>Niveau und Raum-Solltemperatur.|Neigung|Niveau|Betriebsart|Heizen + Warmwasser|Nur Warmwasser|Heizen|Nicht verfügbar|Sensor-Zeitstand:|Messzeitpunkt fehlt|Werte unvollständig|Nur Anzeige|Soll|Raum-Solltemperatur|Referenzpunkte|Ungültige Referenzpunkte|Max.|||Grenze nicht verfügbar||Strom aktuell|Strom heute|Gesamtes Gerät|Verdichter|Heizstab|Heizung + Warmwasser|Heizung + Warmwasser + Kühlung|Nur Heizung|Nur Warmwasser|Nur Kühlung|Stand:|Kein Tageswert für heute|Zeitstand unbekannt|Tageszähler der Anlage|Wärme aktuell|Wärme heute|Kühlung|Heizung an|Heizung aus|Heizung unbekannt|Vorlauf aktuell|Wärmepumpenvorlauf|Heizkreisvorlauf' | split: '|' %}
{% assign decimal = ',' %}
{% else %}
{% assign language = 'en' %}
{% assign labels = 'Viessmann heat pump|Home · Heating circuit|DEMO · Sample data|Not connected|Stale data|Timestamp unknown||Heating|Supply temperature|Hot water|Cylinder temperature|Outdoor|Outdoor sensor|Heating curve|Heating curve with supply limits|Outdoor temperature °C||The heating curve needs slope,<br>offset and a room setpoint.|Slope|Offset|Operating mode|Heating + hot water|Hot water only|Heating|Unavailable|Sensor timestamp:|Reading timestamp missing|Incomplete data|Read only|Target|Room setpoint|Reference points|Invalid reference points|Max.|||Limit unavailable||Electricity now|Electricity today|Whole device|Compressor|Auxiliary heater|Heating + hot water|Heating + hot water + cooling|Heating only|Hot water only|Cooling only|As of:|No counter for today|Timestamp unknown|Device day counter|Heat output now|Heat today|Cooling|Heating on|Heating off|Heating unknown|Supply now|Heat pump supply|Circuit supply' | split: '|' %}
{% assign decimal = '.' %}
{% endif %}
{% assign features = data %}
{% if IDX_0.data %}{% assign features = IDX_0.data %}{% endif %}
{% assign circuit = cfg.circuit | default: '0' | append: '' %}
{% assign prefix = 'heating.circuits.' | append: circuit %}
{% assign supply_key = supply_reading.feature | default: cfg.supply_feature | default: 'heating.secondaryCircuit.sensors.temperature.supply' %}
{% assign water_key = cfg.water_feature | default: 'heating.dhw.sensors.temperature.dhwCylinder' %}
{% assign outside_key = cfg.outside_feature | default: 'heating.sensors.temperature.outside' %}
{% assign curve_key = prefix | append: '.heating.curve' %}
{% assign mode_key = prefix | append: '.operating.modes.active' %}
{% assign supply = nil %}{% assign water = nil %}{% assign outside = nil %}
{% assign slope = nil %}{% assign shift = nil %}{% assign mode = nil %}
{% assign found = 0 %}
{% for f in features %}
  {% assign used = false %}
  {% if f.isEnabled != false %}
    {% case f.feature %}
      {% when supply_key %}
        {% if f.properties.value.value != nil and f.properties.status.value != 'error' %}
          {% assign supply = f.properties.value.value %}{% assign used = true %}
        {% endif %}
      {% when water_key %}
        {% if f.properties.value.value != nil and f.properties.status.value != 'error' %}
          {% assign water = f.properties.value.value %}{% assign used = true %}
        {% endif %}
      {% when outside_key %}
        {% if f.properties.value.value != nil and f.properties.status.value != 'error' %}
          {% assign outside = f.properties.value.value %}{% assign used = true %}
        {% endif %}
      {% when curve_key %}
        {% assign slope = f.properties.slope.value %}{% assign shift = f.properties.shift.value %}
        {% if slope != nil or shift != nil %}{% assign used = true %}{% endif %}
      {% when mode_key %}
        {% assign mode = f.properties.value.value %}
        {% if mode != nil %}{% assign used = true %}{% endif %}
    {% endcase %}
  {% endif %}
  {% if used %}{% assign found = found | plus: 1 %}{% endif %}
{% endfor %}
<style>
  .vp{height:100%;width:100%;box-sizing:border-box;display:flex;flex-direction:column;padding:3%;gap:2.4%;font-family:Arial,sans-serif;color:#000;background:#fff}
  .vp *{box-sizing:border-box}.vp-head{display:flex;align-items:center;justify-content:space-between;border-bottom:3px solid #000;padding-bottom:1.6%;gap:12px}
  .vp-brand{font-size:clamp(15px,2.2vw,26px);font-weight:800;letter-spacing:-.04em}.vp-kicker{font-size:12px;letter-spacing:.12em;text-transform:uppercase}
  .vp-badge{border:2px solid #000;border-radius:4px;padding:5px 8px;font-size:12px;font-weight:bold;text-align:center}
  .vp-metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-bottom:2px solid #000;padding:1% 0 2.5%}
  .vp-metric{padding:0 8%;border-right:1px solid #000}.vp-metric:first-child{padding-left:0}.vp-metric:last-child{border:0}
  .vp-label{font-size:14px;font-weight:bold}.vp-value{font-size:clamp(32px,6.2vw,76px);font-weight:700;letter-spacing:-.06em;line-height:1.2;white-space:nowrap}.vp-unit{font-size:.36em;letter-spacing:0;margin-left:4px}.vp-note{font-size:12px;line-height:1.4}
  .vp-bottom{display:grid;grid-template-columns:1fr;gap:8px;flex:1;min-height:0}.vp-chart{display:flex;flex-direction:column;min-height:0}.vp-chart svg{width:100%;flex:1;min-height:0}.vp-params{display:flex;justify-content:space-between;border-top:1px solid #000;padding-top:5px}.vp-param{font-size:32px;font-weight:bold;line-height:1.25}
  .vp-target{font-size:15px;font-weight:700;margin-top:4px}.vp-points{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:6px;font-size:12px}.vp-point{white-space:nowrap}
  .vp-energy{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:4%;border-bottom:1px solid #000;padding-bottom:1%}.vp-energy-value{font-size:28px;font-weight:750;line-height:1.1}.vp-energy-note{font-size:11px;line-height:1.25}.vp-small .vp-energy-value{font-size:20px}.vp-small .vp-energy-note{font-size:9px}.vp-small .vp-energy .vp-label{font-size:11px}
  .vp-footer{display:flex;justify-content:space-between;gap:12px;font-size:11px;border-top:1px solid #000;padding-top:1.2%}.vp-empty{flex:1;display:flex;align-items:center;justify-content:center;border:1px dashed #000;margin-top:8px;text-align:center;font-size:14px;padding:16px}
  .vp-compact .vp-bottom{display:flex;flex-direction:column}.vp-compact .vp-metrics{align-items:center}.vp-compact .vp-params,.vp-compact .vp-points,.vp-compact .vp-chart>.vp-note{display:none}.vp-compact .vp-chart{flex:1}.vp-compact .vp-chart svg{min-height:55px}.vp-small .vp-metrics{grid-template-columns:1fr;gap:5px}.vp-small .vp-metric{display:flex;justify-content:space-between;align-items:center;border:0;padding:0}.vp-small .vp-value{font-size:28px}.vp-small .vp-metric .vp-note{display:none}.vp-small .vp-kicker{display:none}.vp-small .vp-footer{font-size:10px}.vp-small .vp-brand{font-size:16px}
  .vp-status{border-bottom:1px solid #000;padding-bottom:1%}.vp-status .vp-energy{border:0;padding:0}.vp-small .vp-energy-asof{display:none}
  .vp-energy .vp-label{font-size:12px}.vp-energy-value{font-size:26px}.vp-small .vp-energy{grid-template-columns:repeat(2,minmax(0,1fr));row-gap:7px}
  .vp-heating-on{color:#fff;background:#000}.vp-heating{margin-left:auto;white-space:nowrap}.vp-head>.vp-badge:not(.vp-heating){font-size:10px}.vp-param{font-size:22px}.vp-small .vp-metrics{grid-template-columns:repeat(2,minmax(0,1fr));gap:5px}.vp-small .vp-value{font-size:24px}.vp-small .vp-target{font-size:10px}.vp-small .vp-head{gap:5px}.vp-small .vp-heating{font-size:10px;padding:4px}.vp-small .vp-metrics .vp-note{display:none}
  .vp-compact{padding:2%;gap:1%}.vp-compact .vp-head{padding-bottom:1%}.vp-compact .vp-brand{font-size:18px}.vp-compact .vp-kicker{font-size:9px}.vp-compact .vp-value{font-size:32px}.vp-compact .vp-label{font-size:12px}.vp-compact .vp-metrics{padding:0 0 1%}.vp-compact .vp-note{font-size:10px}.vp-compact .vp-target{font-size:11px;margin-top:0}.vp-compact .vp-energy-value{font-size:20px}.vp-compact .vp-energy-note{font-size:9px}.vp-compact .vp-energy-asof{display:none}.vp-compact .vp-footer{font-size:9px}.vp-small .vp-metric{display:block;padding:0 5%;border-right:1px solid #000}.vp-small .vp-value{font-size:24px}.vp-small .vp-brand{font-size:16px}.vp-small .vp-metrics .vp-metric:first-child{padding-left:0}.vp-small .vp-metrics .vp-metric:last-child{border:0}.vp-small .vp-heating{font-size:9px}.vp-small .vp-target{font-size:10px}
</style>
<div class="vp{% if variant != 'full' %} vp-compact{% endif %}{% if variant == 'half_vertical' or variant == 'quadrant' %} vp-small{% endif %}" lang="{{ language }}">
  <div class="vp-head"><div><div class="vp-kicker">{{ labels[1] }} {{ circuit | escape }}</div><div class="vp-brand">{{ labels[0] }}</div></div>
    {% if demo or found == 0 or freshness.stale or freshness.missing_time %}<div class="vp-badge">{% if demo %}{{ labels[2] }}{% elsif found == 0 %}{{ labels[3] }}{% elsif freshness.stale %}{{ labels[4] }}{% elsif freshness.missing_time %}{{ labels[5] }}{% endif %}</div>{% endif %}
    <div class="vp-badge vp-heating{% if heating.state == 'on' %} vp-heating-on{% endif %}">{% case heating.state %}{% when 'on' %}{{ labels[55] }}{% when 'off' %}{{ labels[56] }}{% else %}{{ labels[57] }}{% endcase %}</div>
  </div>
  <div class="vp-metrics">
    <div class="vp-metric"><div class="vp-label">{{ labels[9] }}</div><div class="vp-value">{% if water != nil %}{{ water | round: 1 | replace: '.', decimal }}{% else %}—{% endif %}<span class="vp-unit">°C</span></div><div class="vp-note">{{ labels[10] }}</div><div class="vp-target">{{ labels[29] }}: {% if setpoints.water != nil %}{{ setpoints.water | round: 1 | replace: '.', decimal }} °C{% else %}—{% endif %}</div></div>
    <div class="vp-metric"><div class="vp-label">{{ labels[11] }}</div><div class="vp-value">{% if outside != nil %}{{ outside | round: 1 | replace: '.', decimal }}{% else %}—{% endif %}<span class="vp-unit">°C</span></div><div class="vp-note">{{ labels[12] }}</div></div>
  </div>
  <div class="vp-status">
  <div class="vp-energy">
    <div><div class="vp-label">{{ labels[38] }}</div><div class="vp-energy-value">{% if energy.power_kw != nil %}{{ energy.power_kw | round: 2 | replace: '.', decimal }}{% else %}—{% endif %} <span class="vp-unit">kW</span></div><div class="vp-energy-note">{% case energy.power_scope %}{% when 'device' %}{{ labels[40] }}{% when 'compressor' %}{{ labels[41] }}{% when 'heater' %}{{ labels[42] }}{% else %}{{ labels[24] }}{% endcase %}{% if energy.power_stale %} · {{ labels[4] }}{% endif %}</div><div class="vp-energy-note vp-energy-asof">{% if energy.power_updated %}{{ labels[48] }} {{ energy.power_updated | escape }}{% elsif energy.power_kw != nil %}{{ labels[50] }}{% endif %}</div></div>
    <div><div class="vp-label">{{ labels[39] }}</div><div class="vp-energy-value">{% if energy.today_kwh != nil %}{{ energy.today_kwh | round: 2 | replace: '.', decimal }}{% else %}—{% endif %} <span class="vp-unit">kWh</span></div><div class="vp-energy-note">{% case energy.today_scope %}{% when 'device' %}{{ labels[40] }}{% when 'compressor' %}{{ labels[41] }}{% when 'heater' %}{{ labels[42] }}{% when 'heating_dhw' %}{{ labels[43] }}{% when 'heating_dhw_cooling' %}{{ labels[44] }}{% when 'heating' %}{{ labels[45] }}{% when 'dhw' %}{{ labels[46] }}{% when 'cooling' %}{{ labels[47] }}{% else %}{% if energy.today_outdated %}{{ labels[49] }}{% else %}{{ labels[24] }}{% endif %}{% endcase %}{% render "daily_counter_age", metric: energy, labels: labels %}</div><div class="vp-energy-note vp-energy-asof">{% render "daily_counter_timestamps", metric: energy, labels: labels %}</div></div>
    <div><div class="vp-label">{{ labels[52] }}</div><div class="vp-energy-value">{% if heat.power_kw != nil %}{{ heat.power_kw | round: 2 | replace: '.', decimal }}{% else %}—{% endif %} <span class="vp-unit">kW</span></div><div class="vp-energy-note">{% case heat.power_scope %}{% when 'device' %}{{ labels[40] }}{% when 'compressor' %}{{ labels[41] }}{% when 'heater' %}{{ labels[42] }}{% else %}{{ labels[24] }}{% endcase %}{% if heat.power_stale %} · {{ labels[4] }}{% endif %}</div><div class="vp-energy-note vp-energy-asof">{% if heat.power_updated %}{{ labels[48] }} {{ heat.power_updated | escape }}{% elsif heat.power_kw != nil %}{{ labels[50] }}{% endif %}</div></div>
    <div><div class="vp-label">{{ labels[53] }}</div><div class="vp-energy-value">{% if heat.today_kwh != nil %}{{ heat.today_kwh | round: 2 | replace: '.', decimal }}{% else %}—{% endif %} <span class="vp-unit">kWh</span></div><div class="vp-energy-note">{% case heat.today_scope %}{% when 'device' %}{{ labels[40] }}{% when 'compressor' %}{{ labels[41] }}{% when 'heater' %}{{ labels[42] }}{% when 'heating_dhw' %}{{ labels[43] }}{% when 'heating_dhw_cooling' %}{{ labels[44] }}{% when 'heating' %}{{ labels[45] }}{% when 'dhw' %}{{ labels[46] }}{% when 'cooling' %}{{ labels[47] }}{% else %}{% if heat.today_outdated %}{{ labels[49] }}{% else %}{{ labels[24] }}{% endif %}{% endcase %}{% render "daily_counter_age", metric: heat, labels: labels %}</div><div class="vp-energy-note vp-energy-asof">{% render "daily_counter_timestamps", metric: heat, labels: labels %}</div></div>
  </div>
  </div>
  <div class="vp-bottom">
    <div class="vp-chart"><div class="vp-label">{{ labels[13] }}</div>
    {% if curve.points.size > 1 %}
      <svg viewBox="0 0 620 210" role="img" aria-label="{% if curve.reference %}{{ labels[31] }}{% else %}{{ labels[14] }}{% endif %}" preserveAspectRatio="xMidYMid meet">
        <path d="M48 20V156H434" fill="none" stroke="#000"/>
        {% for tick in curve.ticks %}<path d="M48 {{ tick.y }}H434" fill="none" stroke="#000" stroke-dasharray="2 5"/><text x="40" y="{{ tick.y | plus: 4 }}" text-anchor="end" font-size="12">{{ tick.value | replace: '.', decimal }}</text>{% endfor %}
        {% for tick in curve.x_ticks %}<text x="{{ tick.x }}" y="178" text-anchor="middle" font-size="12">{{ tick.value | replace: '.', decimal }}</text>{% endfor %}
        <text x="6" y="14" font-size="12">°C</text><text x="235" y="204" text-anchor="middle" font-size="12">{{ labels[15] }}</text>
        {% if curve.cap_y != nil %}<path d="M48 {{ curve.cap_y }}H434" stroke="#000" stroke-width="1.5" stroke-dasharray="7 4"/>{% endif %}
        <polyline fill="none" stroke="#000" stroke-width="3" points="{{ curve.polyline | escape }}"/>
        {% for point in curve.points %}<circle cx="{{ point.x }}" cy="{{ point.y }}" r="{% if point.label %}3{% else %}1.5{% endif %}" fill="#000"/>{% endfor %}
        {% if curve.measured %}<path class="vp-measured-guide" d="M48 {{ curve.measured.y }}H{{ curve.measured.x }}V156" fill="none" stroke="#000" stroke-dasharray="3 3"/>{% endif %}
        {% if curve.target %}<path class="vp-target-marker" d="M{{ curve.target.x }} {{ curve.target.y | minus: 8 }}l8 8 -8 8 -8 -8Z" fill="#fff" stroke="#000" stroke-width="2"/>{% endif %}
        {% if curve.measured %}<circle class="vp-supply-marker" cx="{{ curve.measured.x }}" cy="{{ curve.measured.y }}" r="5" fill="#000" stroke="#fff" stroke-width="1.5"/>{% endif %}
        <g class="vp-curve-readings" font-family="Arial, sans-serif">
          <circle cx="463" cy="42" r="5" fill="#000"/>
          <text x="477" y="46" font-size="13">{% case supply_scope %}{% when 'heat_pump' %}{{ labels[59] }}{% when 'circuit' %}{{ labels[60] }}{% else %}{{ labels[58] }}{% endcase %}</text>
          <text x="477" y="73" font-size="24" font-weight="bold">{% if supply != nil %}{{ supply | round: 1 | replace: '.', decimal }}{% else %}—{% endif %} °C</text>
          <path d="M463 94l5 5 -5 5 -5 -5Z" fill="#fff" stroke="#000" stroke-width="2"/>
          <text x="477" y="103" font-size="13">{{ labels[29] }}</text>
          <text x="477" y="130" font-size="24" font-weight="bold">{% if setpoints.supply != nil %}{{ setpoints.supply | round: 1 | replace: '.', decimal }}{% else %}—{% endif %} °C</text>
        </g>
      </svg>
      <div class="vp-points">{% for point in curve.points %}{% if point.label %}<span class="vp-point">{{ point.outdoor | replace: '.', decimal }}° → <b>{{ point.supply | replace: '.', decimal }}°</b></span>{% endif %}{% endfor %}</div>
      <div class="vp-note">{% if curve.invalid_reference %}{{ labels[32] }}{% elsif curve.reference %}{{ labels[31] }}{% else %}{% if curve.max_supply != nil %}{{ labels[33] }} {{ curve.max_supply | replace: '.', decimal }} °C{% else %}{{ labels[36] }}{% endif %}{% endif %}</div>
    {% else %}<div class="vp-empty">{{ labels[17] }}</div><div class="vp-note">{% case supply_scope %}{% when 'heat_pump' %}{{ labels[59] }}{% when 'circuit' %}{{ labels[60] }}{% else %}{{ labels[58] }}{% endcase %}: {% if supply != nil %}{{ supply | round: 1 | replace: '.', decimal }} °C{% else %}—{% endif %} · {{ labels[29] }}: {% if setpoints.supply != nil %}{{ setpoints.supply | round: 1 | replace: '.', decimal }} °C{% else %}—{% endif %}</div>{% endif %}
    </div>
    <div class="vp-params"><div><div class="vp-label">{{ labels[18] }}</div><div class="vp-param">{% if slope != nil %}{{ slope | replace: '.', decimal }}{% else %}—{% endif %}</div></div><div><div class="vp-label">{{ labels[19] }}</div><div class="vp-param">{% if shift != nil %}{{ shift | replace: '.', decimal }} K{% else %}—{% endif %}</div></div><div><div class="vp-label">{{ labels[30] }}</div><div class="vp-param">{% if setpoints.room != nil %}{{ setpoints.room | round: 1 | replace: '.', decimal }} °C{% else %}—{% endif %}</div></div></div>
  </div>
  <div class="vp-footer"><span>{% if freshness.oldest_sensor %}{{ labels[25] }} {{ freshness.oldest_sensor | escape }}{% else %}{{ labels[26] }}{% endif %}</span><span>{% if found < 5 %}{{ labels[27] }}{% else %}{{ labels[28] }}{% endif %} · TRMNL X</span></div>
</div>

{% endtemplate %}
