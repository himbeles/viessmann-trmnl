  .vp:not(.vp-compact) .vp-power-block{padding:10px;gap:6px}.vp-small .vp-chart-head{display:none}.vp-small .vp-chart{gap:0}.vp-small .vp-plot-graphic>.vp-params{margin-bottom:0}.vp-small .vp-heating-summary{padding-top:1px}.vp-small .vp-water-block{padding:5px;gap:2px}.vp-small .vp-water-block .vp-use-energy b{font-size:11px}.vp-small .vp-water-block .vp-use-energy .vp-label{font-size:7px}

  .vp-chart-head .vp-params{justify-content:flex-end;align-self:auto}.vp-day-comparison{display:grid;grid-template-columns:minmax(0,1fr) 26px minmax(0,1.35fr);align-items:end;gap:10px}.vp-day-label{font-size:11px;line-height:1.2;margin-top:3px}.vp-yesterday{color:#666}.vp-comparison-arrow{align-self:center;text-align:center;color:#666}.vp-trend{font-size:24px}.vp-compact .vp-day-comparison{grid-template-columns:minmax(0,1fr) 14px minmax(0,1.2fr);gap:4px}.vp-compact .vp-day-label{font-size:9px}.vp-compact .vp-trend{font-size:18px}.vp-compact:not(.vp-small) .vp-day-comparison{grid-template-columns:minmax(0,1fr) 10px minmax(0,1fr);gap:2px}.vp-compact:not(.vp-small) .vp-day-comparison .vp-energy-value{font-size:20px}.vp-small .vp-chart-head{display:flex;justify-content:flex-end}.vp-small .vp-day-label{font-size:7px}.vp-small .vp-day-comparison{gap:2px;grid-template-columns:minmax(0,1fr) 10px minmax(0,1.2fr)}.vp-small .vp-trend{font-size:13px}.vp-small .vp-energy-value{font-size:16px}
  .vp-day-comparison{display:flex;align-items:flex-end;gap:10px}.vp-comparison-arrow{width:38px;flex:none;align-self:center}.vp-trend{font-size:40px;line-height:1}.vp-compact .vp-day-comparison{gap:6px}.vp-compact .vp-comparison-arrow{width:26px}.vp-compact .vp-trend{font-size:28px}.vp-compact:not(.vp-small) .vp-day-comparison{gap:4px}.vp-compact:not(.vp-small) .vp-comparison-arrow{width:22px}.vp-small .vp-day-comparison{gap:4px}.vp-small .vp-comparison-arrow{width:18px}.vp-small .vp-trend{font-size:20px}
</style>
<div class="vp{% if variant != 'full' %} vp-compact{% endif %}{% if variant == 'half_vertical' or variant == 'quadrant' %} vp-small{% endif %}" lang="{{ language }}">
  <div class="vp-head"><div><div class="vp-kicker">{{ labels[1] }} {{ circuit | escape }}</div><div class="vp-brand">{{ labels[0] }}</div></div>
    {% if demo or found == 0 or freshness.missing_time %}<div class="vp-badge">{% if demo %}{{ labels[2] }}{% elsif found == 0 %}{{ labels[3] }}{% elsif freshness.missing_time %}{{ labels[5] }}{% endif %}</div>{% endif %}
    <div class="vp-badge vp-activity{% if activity.state == 'dhw' or activity.state == 'heating' %} vp-activity-on{% endif %}">{% case activity.state %}{% when 'dhw' %}{{ labels[9] }}{% when 'heating' %}{{ labels[7] }}{% when 'off' %}{{ labels[63] }}{% else %}{{ labels[64] }}{% endcase %}</div>
  </div>
  <div class="vp-blocks">
    <section class="vp-block vp-heating-block{% if temperatures.heating.active %} vp-block-active{% endif %}" aria-label="{{ labels[7] }}">
      <h2 class="vp-block-title">{% render "glyph", kind: "heating" %}{{ labels[7] }}</h2>
      <div class="vp-metrics">
        <div class="vp-metric"><div class="vp-label">{{ labels[11] }}</div><div class="vp-value">{% if outside != nil %}{{ outside | round: 1 | replace: '.', decimal }}{% else %}—{% endif %}<span class="vp-unit">°C</span></div></div>
        <div class="vp-metric vp-room-target"><div class="vp-label">{{ labels[30] }}</div><div class="vp-value">{% if setpoints.room != nil %}{{ setpoints.room | round: 1 | replace: '.', decimal }}{% else %}—{% endif %}<span class="vp-unit">°C</span></div></div>
      <div class="vp-metric vp-pressure"><div class="vp-label">{% render "glyph", kind: "pressure" %}{{ labels[61] }}</div><div class="vp-value">{% if pressure.bar != nil %}{{ pressure.bar | round: 2 | replace: '.', decimal }}{% else %}—{% endif %}<span class="vp-unit">bar</span></div><div class="vp-note">{% if pressure.bar != nil %}{% else %}{{ labels[24] }}{% endif %}</div></div>
      </div>
  <div class="vp-bottom">
    <div class="vp-chart"><div class="vp-chart-head"><div class="vp-label">{{ labels[13] }}</div><div class="vp-params"><div><div class="vp-label">{{ labels[18] }}</div><div class="vp-param">{% if slope != nil %}{{ slope | replace: '.', decimal }}{% else %}—{% endif %}</div></div><div><div class="vp-label">{{ labels[19] }}</div><div class="vp-param">{% if shift != nil %}{{ shift | replace: '.', decimal }} K{% else %}—{% endif %}</div></div></div></div>
    <div class="vp-plot-row"><div class="vp-plot-graphic">
    {% if curve.points.size > 1 %}
      <svg viewBox="0 0 460 270" role="img" aria-label="{% if curve.reference %}{{ labels[31] }}{% else %}{{ labels[14] }}{% endif %}" preserveAspectRatio="xMidYMid meet">
        <path d="M48 20V216H434" fill="none" stroke="#000"/>
        {% for tick in curve.ticks %}<path d="M48 {{ tick.y }}H434" fill="none" stroke="#000" stroke-dasharray="2 5"/><text x="40" y="{{ tick.y | plus: 4 }}" text-anchor="end" font-size="12">{{ tick.value | replace: '.', decimal }}</text>{% endfor %}
        {% for tick in curve.x_ticks %}<path class="vp-x-tick" d="M{{ tick.x }} 216v4" stroke="#000"/><text x="{{ tick.x }}" y="238" text-anchor="middle" font-size="12">{{ tick.value | replace: '.', decimal }}</text>{% endfor %}
        <text x="6" y="14" font-size="12">°C</text><text x="235" y="264" text-anchor="middle" font-size="12">{{ labels[15] }}</text>
        <polyline fill="none" stroke="#000" stroke-width="3" points="{{ curve.polyline | escape }}"/>
        {% for point in curve.step_points %}<circle class="vp-curve-step" cx="{{ point.x }}" cy="{{ point.y }}" r="2.5" fill="#000"/>{% endfor %}
        {% if curve.target %}<path class="vp-target-marker" d="M{{ curve.target.x }} {{ curve.target.y | minus: 8 }}l8 8 -8 8 -8 -8Z" fill="#fff" stroke="#000" stroke-width="2"/>{% endif %}

      </svg>
      {% if curve.invalid_reference %}<div class="vp-note">{{ labels[32] }}</div>{% elsif curve.reference %}<div class="vp-note">{{ labels[31] }}</div>{% endif %}
    {% else %}<div class="vp-empty">{{ labels[17] }}</div>{% endif %}
    </div><div class="vp-supply-readings"><div class="vp-supply-actual"><div class="vp-value">{% if radiator.supply != nil %}{{ radiator.supply | round: 1 | replace: '.', decimal }}{% else %}—{% endif %}<span class="vp-unit">°C</span></div><div class="vp-note">{{ labels[69] }}</div></div><div class="vp-supply-target vp-target vp-curve-readings" aria-label="{{ labels[68] }}"><span class="vp-full-label">{{ labels[29] }}</span>: <span class="vp-value">{% if radiator.target != nil %}{{ radiator.target | round: 1 | replace: '.', decimal }}{% else %}—{% endif %} °C</span></div></div></div>
    </div>
  </div>
      <div class="vp-heating-summary">
      {% render "use_energy", scope: "heating", energy: energy, heat: heat, labels: labels, decimal: decimal %}
      </div>
    </section>
    <section class="vp-block vp-water-block{% if activity.state == 'dhw' %} vp-block-active{% endif %}" aria-label="{{ labels[9] }}"><h2 class="vp-block-title">{% render "glyph", kind: "water" %}{{ labels[9] }}</h2>
    <div class="vp-water"><div class="vp-value">{% if water != nil %}{{ water | round: 1 | replace: '.', decimal }}{% else %}—{% endif %}<span class="vp-unit">°C</span></div><div class="vp-note">{{ labels[10] }}</div><div class="vp-target">{{ labels[29] }}: {% if setpoints.water != nil %}{{ setpoints.water | round: 1 | replace: '.', decimal }} °C{% else %}—{% endif %}</div></div>
      {% render "use_energy", scope: "dhw", energy: energy, heat: heat, labels: labels, decimal: decimal %}
    </section>
    <section class="vp-block vp-power-block" aria-label="{{ labels[70] }}"><h2 class="vp-block-title">{{ labels[70] }}</h2>
      <div class="vp-power">
    <div><div class="vp-label">{{ labels[38] }}</div><div class="vp-energy-value">{% if energy.power_kw != nil %}{{ energy.power_kw | round: 2 | replace: '.', decimal }}{% else %}—{% endif %} <span class="vp-unit">kW</span></div><div class="vp-energy-note">{% case energy.power_scope %}{% when 'device' %}{{ labels[40] }}{% when 'compressor' %}{{ labels[41] }}{% when 'heater' %}{{ labels[42] }}{% else %}{{ labels[24] }}{% endcase %}</div></div>
    <div><div class="vp-label">{{ labels[52] }}</div><div class="vp-energy-value">{% if heat.power_kw != nil %}{{ heat.power_kw | round: 2 | replace: '.', decimal }}{% else %}—{% endif %} <span class="vp-unit">kW</span></div><div class="vp-energy-note">{% case heat.power_scope %}{% when 'device' %}{{ labels[40] }}{% when 'compressor' %}{{ labels[41] }}{% when 'heater' %}{{ labels[42] }}{% else %}{{ labels[24] }}{% endcase %}</div></div>
      </div>
      <div class="vp-components">
        {% assign component_keys = 'compressor,auxiliary,fan' | split: ',' %}
        {% for component in component_keys %}{% assign state = components[component] %}
        <div class="vp-component" data-component="{{ component }}" data-state="{{ state | default: 'unknown' }}">{% render "glyph", kind: component %}<span>{% case component %}{% when 'compressor' %}{{ labels[41] }}{% when 'auxiliary' %}{{ labels[42] }}{% when 'fan' %}{{ labels[71] }}{% endcase %}</span><b class="vp-component-state{% if state == 'on' %} vp-component-on{% endif %}">{% case state %}{% when 'on' %}{{ labels[72] }}{% when 'off' %}{{ labels[63] }}{% else %}—{% endcase %}</b></div>
        {% endfor %}
      </div>
    </section>
    <section class="vp-block vp-energy-block" aria-label="{{ labels[62] }}"><h2 class="vp-block-title">{{ labels[62] }}</h2>
  <div class="vp-energy">
    <div><div class="vp-label">{{ labels[77] }}</div>{% render "day_comparison", metrics: energy, labels: labels, decimal: decimal %}<div class="vp-energy-note">{% case energy.today_scope %}{% when 'device' %}{{ labels[40] }}{% when 'compressor' %}{{ labels[41] }}{% when 'heater' %}{{ labels[42] }}{% when 'heating_dhw' %}{{ labels[43] }}{% when 'heating_dhw_cooling' %}{{ labels[44] }}{% when 'heating' %}{{ labels[45] }}{% when 'dhw' %}{{ labels[46] }}{% when 'cooling' %}{{ labels[47] }}{% else %}{% if energy.today_outdated %}{{ labels[49] }}{% else %}{{ labels[24] }}{% endif %}{% endcase %}</div></div>
    <div><div class="vp-label">{{ labels[78] }}</div><div class="vp-today"><div class="vp-day-label">{{ labels[79] }}</div><div class="vp-energy-value">{% if heat.today_kwh != nil %}{{ heat.today_kwh | round: 2 | replace: '.', decimal }}{% else %}—{% endif %} <span class="vp-unit">kWh</span></div></div><div class="vp-energy-note">{% if heat.today_kwh != nil %}{{ labels[40] }}{% elsif heat.today_outdated %}{{ labels[49] }}{% else %}{{ labels[24] }}{% endif %}</div></div>
  </div>
    </section>
  </div>
  <div class="vp-footer"><span>{% if freshness.latest_reading %}{{ labels[67] }} {{ freshness.latest_reading | escape }}{% else %}{{ labels[26] }}{% endif %}</span></div>
</div>

{% endtemplate %}
